# Copie este arquivo para .env e preencha com as chaves do Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > Web)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Endereço final do site (ajuste depois de publicar)
VITE_SITE_URL=https://ecarlossantos43.netlify.app

# Opcional: fotos no Cloudinary em vez do Firebase Storage (plano gratuito)
# VITE_CLOUDINARY_CLOUD_NAME=
# VITE_CLOUDINARY_UPLOAD_PRESET=
